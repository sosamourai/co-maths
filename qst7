
def mediane(valeurs):
    """Retourne la médiane d'une liste de nombres, None si la liste est vide."""
    n = len(valeurs)
    if n == 0:
        return None
    tri = sorted(valeurs)  # tri sans modifier la liste d'origine
    mid = n // 2
    if n % 2 == 1:
        return tri[mid]
    else:
        return (tri[mid - 1] + tri[mid]) / 2

